<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="726.0" prefWidth="845.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ipap.finrabklev.TrajectoryController">
   <children>
      <Canvas fx:id="canvasField" height="534.0" layoutX="37.0" layoutY="129.0" width="500.0" />
      <TableView fx:id="tablePoits" layoutX="560.0" layoutY="125.0" prefHeight="534.0" prefWidth="271.0">
        <columns>
          <TableColumn fx:id="tablePoint" prefWidth="75.0" text="C1" />
          <TableColumn prefWidth="75.0" text="C2" />
        </columns>
      </TableView>
      <HBox layoutX="13.0" layoutY="14.0" prefHeight="100.0" prefWidth="819.0">
         <children>
            <Button fx:id="BtnStart" mnemonicParsing="false" prefHeight="98.0" prefWidth="137.0" text="Запустить Программу" textAlignment="CENTER" />
            <Button fx:id="btnStep" mnemonicParsing="false" prefHeight="100.0" prefWidth="126.0" text="Выполнить один шаг" textAlignment="CENTER" wrapText="true" />
            <Button fx:id="btnClier" mnemonicParsing="false" prefHeight="100.0" prefWidth="114.0" text="Очистить траекторию, вернуться в точку 0.0" textAlignment="CENTER" wrapText="true" />
            <Label fx:id="labelCarrentStep" prefHeight="43.0" prefWidth="108.0" text="Текущий шаг" textAlignment="CENTER" wrapText="true" />
            <ListView fx:id="listOfCommands" orientation="HORIZONTAL" prefHeight="100.0" prefWidth="331.0" />
         </children>
      </HBox>
      <TextArea fx:id="logArea" layoutX="29.0" layoutY="666.0" prefHeight="34.0" prefWidth="582.0" />
   </children>
</AnchorPane>
